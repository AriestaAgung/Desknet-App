{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "DesknetApp", "target-membership": [ "DesknetApp" ] },
    { "kind": "folder", "path": "DesknetAgent", "target-membership": [ "DesknetAgent" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Desknet.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/DesknetAgent.framework", "id": "000000000000000000000220", "type": "wrapper.framework", "index": false, "target-membership": [ { "build-phase": "DesknetApp/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "DesknetApp",
      "id": "000000000000000100000000",
      "product": "Products/Desknet.app",
      "product-type": "application",
      "dependencies": [
        "DesknetAgent",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Build Simulator Agent",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/DesknetAgent/DesknetAgent.swift",
            "$(SRCROOT)/DesknetAgent/DesknetAgentBootstrap.m",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Agent/iphonesimulator/DesknetAgent.framework/DesknetAgent",
          ],
          "shell": "/bin/sh",
          "script": [
            "# Simulator build of the agent, shipped in Resources and installed by DesknetAgentInstaller.",
            "# ponytail: arm64 only (Apple silicon); add x86_64 to the -target list for Intel Macs.",
            "set -e",
            "SDK=$(xcrun --sdk iphonesimulator --show-sdk-path)",
            "TRIPLE=arm64-apple-ios16.0-simulator",
            "OUT=\"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/Agent/iphonesimulator/DesknetAgent.framework\"",
            "OBJ=\"$DERIVED_FILE_DIR/agent-sim\"",
            "mkdir -p \"$OUT\" \"$OBJ\"",
            "xcrun --sdk iphonesimulator clang -c -fobjc-arc -target $TRIPLE -isysroot \"$SDK\" \"$SRCROOT/DesknetAgent/DesknetAgentBootstrap.m\" -o \"$OBJ/bootstrap.o\"",
            "xcrun --sdk iphonesimulator swiftc -emit-library -target $TRIPLE -sdk \"$SDK\" -module-name DesknetAgent -module-cache-path \"$OBJ/ModuleCache\" \"$SRCROOT/DesknetAgent/DesknetAgent.swift\" \"$OBJ/bootstrap.o\" -Xlinker -install_name -Xlinker @rpath/DesknetAgent.framework/DesknetAgent -o \"$OUT/DesknetAgent\"",
            "/usr/libexec/PlistBuddy -c \"Clear dict\" -c \"Add :CFBundleExecutable string DesknetAgent\" -c \"Add :CFBundleIdentifier string dev.desknet.agent\" -c \"Add :CFBundlePackageType string FMWK\" -c \"Add :CFBundleSupportedPlatforms array\" -c \"Add :CFBundleSupportedPlatforms:0 string iPhoneSimulator\" \"$OUT/Info.plist\" >/dev/null 2>&1 || /usr/libexec/PlistBuddy -c \"Add :CFBundleExecutable string DesknetAgent\" -c \"Add :CFBundleIdentifier string dev.desknet.agent\" -c \"Add :CFBundlePackageType string FMWK\" -c \"Add :CFBundleSupportedPlatforms array\" -c \"Add :CFBundleSupportedPlatforms:0 string iPhoneSimulator\" \"$OUT/Info.plist\"",
            "codesign --force --sign - --timestamp=none \"$OUT\"",
            "",
          ],
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "R2D4D7YLB2",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.desknet.app",
        "PRODUCT_NAME": "Desknet",
        "SDKROOT": "macosx",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "DesknetAgent",
      "id": "000000000000000200000000",
      "product": "Products/DesknetAgent.framework",
      "product-type": "framework",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "CODE_SIGNING_ALLOWED": "NO",
        "DEFINES_MODULE": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.desknet.agent",
        "PRODUCT_NAME": "DesknetAgent",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_VERSION": "5.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "27.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PROJECT_UNIQUE_VALUE": "KUWVT935",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "26.3",
}
